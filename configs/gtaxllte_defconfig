# Kernel configuration for the gtaxllte first bring-up.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# A native (--skip-prelink) kernel has no original crypto kext to register
# g_crypto_funcs. The source corecrypto provider must initialize it, or the
# first SHA-1 user (IOPlatformExpertDevice::generatePlatformUUID) faults on a
# NULL digest table.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
# No storage, display, input or GPU driver yet. The first image stops at the
# root mount after the kernel entry checkpoint.
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# The shared ARM64 fragment selects SoftwareAES, whose NativeAES subclasses
# IOAESAccelerator from the prelinked kext collection. A --skip-prelink kernel
# does not map that collection, so the class is excluded from the build.
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_DT_PANIC_REGION=y
