# Kernel configuration for the gtaxllte first bring-up.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# The native kernel does not register the source crypto provider yet: its
# start path hangs on this SoC before storage bring-up. Prelinked mode compiles
# the source bootstrap out (no seal-script requirement), and
# zzz-kmem-no-crypto.patch makes the kmem wrapper tolerate the empty table.
# The platform UUID is crypto-free; restore the provider after eMMC/root work.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# No storage, display, input or GPU driver yet. The first image stops at the
# root mount after the kernel entry checkpoint.
# CONFIG_XNU_NATIVE_UFS is not set
CONFIG_XNU_NATIVE_DWMMC=y
# The packed Data seed published by the loader as a RAM block device. The
# owner cache/Data mounts use the original XNU mount code; NativeDwMmc answers
# its block-device hooks from the SHNGROOT windows under an explicit bring-up
# boot argument (gtaxllte-allow-unverified=1).
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="76BACD4A-80F1-48F0-B5B6-5A3DE1F123A5"
# Diagnostic pass: the prelinked trust-cache runtime initializer runs before
# the original AMFI kext has registered its interface on this board and stops
# before the display probe. Leave it off until the native AMFI table lands; the
# owner cache/Data mounts do not depend on it.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
# The GOP/flat-panel legacy backend: the original IOMobileGraphicsFamily
# lifecycle with an owned framebuffer backend, CPU presentation and the
# firmware GOP as scanout. It needs the prelinked family closure in board.toml.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# CONFIG_XNU_NATIVE_ADRENO is not set
# The shared ARM64 fragment selects SoftwareAES, whose NativeAES subclasses
# IOAESAccelerator from the prelinked kext collection. A --skip-prelink kernel
# does not map that collection, so the class is excluded from the build.
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_DT_PANIC_REGION=y
