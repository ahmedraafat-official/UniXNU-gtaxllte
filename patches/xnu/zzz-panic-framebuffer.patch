--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -337,6 +337,63 @@
 }
 
 /*
+ * gtaxllte bring-up markers: direct writes to the UEFI panel framebuffer,
+ * independent of the console and the panic path. The five vinfo fields match
+ * the prefix of the kernel's struct vc_info.
+ */
+struct gtaxllte_vc_info {
+	unsigned int  v_height;
+	unsigned int  v_width;
+	unsigned int  v_depth;
+	unsigned int  v_rowbytes;
+	unsigned long v_baseaddr;
+};
+extern struct gtaxllte_vc_info vinfo;
+
+void
+gtaxllte_fb_mark(unsigned int index, unsigned int color)
+{
+	volatile unsigned int *fb;
+	unsigned int row, x, y, dy;
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_width == 0 ||
+	    vinfo.v_rowbytes < vinfo.v_width * 4) {
+		return;
+	}
+	fb = (volatile unsigned int *)vinfo.v_baseaddr;
+	row = vinfo.v_rowbytes / 4;
+	x = 40 + (index % 18) * 64;
+	y = 820 + (index / 18) * 64;
+	if (x + 48 > vinfo.v_width || y + 48 > vinfo.v_height) {
+		return;
+	}
+	for (dy = 0; dy < 48; dy++) {
+		for (unsigned int dx = 0; dx < 48; dx++) {
+			fb[(y + dy) * row + x + dx] = color;
+		}
+	}
+}
+
+void
+gtaxllte_fb_bar(unsigned int y, unsigned int color)
+{
+	volatile unsigned int *fb;
+	unsigned int row, x, dy;
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_width == 0 ||
+	    vinfo.v_rowbytes < vinfo.v_width * 4 || y + 32 > vinfo.v_height) {
+		return;
+	}
+	fb = (volatile unsigned int *)vinfo.v_baseaddr;
+	row = vinfo.v_rowbytes / 4;
+	for (dy = 0; dy < 32; dy++) {
+		for (x = 0; x < vinfo.v_width; x++) {
+			fb[(y + dy) * row + x] = color;
+		}
+	}
+}
+
+/*
  *		Routine:		arm_init
  *		Function:		Runs on the boot CPU, once, on entry from iBoot.
  */
@@ -521,6 +578,13 @@
 
 	arm_vm_init(xmaxmem, args);
 
+	vinfo.v_baseaddr = (unsigned long)ml_io_map_wcomb(0x67000000, 0x008ca000);
+	vinfo.v_width    = 1200;
+	vinfo.v_height   = 1920;
+	vinfo.v_depth    = 32;
+	vinfo.v_rowbytes = 1200 * 4;
+	gtaxllte_fb_bar(400, 0x0000FF00);   /* arm_vm_init returned: green */
+
 	if (debug_boot_arg) {
 		patch_low_glo();
 	}
@@ -578,6 +642,7 @@
 
