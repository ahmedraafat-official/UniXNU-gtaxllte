--- a/osfmk/arm/arm_init.c	2026-11-15 19:47:24
+++ b/osfmk/arm/arm_init.c	2026-11-15 19:47:24
@@ -73,7 +73,10 @@
 #include <libkern/section_keywords.h>
 #include <san/kasan.h>
 #include <sys/kdebug.h>
+#include <mach/kmod.h>
 
+extern kern_return_t corecrypto_kext_start(kmod_info_t *, void *);
+
 #include <pexpert/pexpert.h>
 
 #include <console/serial_protos.h>
@@ -337,6 +340,22 @@
 }
 
 /*
+ * A native (--skip-prelink) kernel has no original corecrypto kext. Its source
+ * provider is linked but its entry point is never called, so g_crypto_funcs
+ * stays NULL and the first digest or kmem-RNG user crashes. Call the source
+ * provider's own start entry after the console is available. fips_mode=4
+ * disables the FIPS POST, which then only records the Mach header.
+ */
+static kmod_info_t gtaxllte_crypto_kmod;
+
+static void
+gtaxllte_register_source_crypto(void)
+{
+	gtaxllte_crypto_kmod.address = (vm_address_t)&_mh_execute_header;
+	corecrypto_kext_start(&gtaxllte_crypto_kmod, NULL);
+}
+
+/*
  *		Routine:		arm_init
  *		Function:		Runs on the boot CPU, once, on entry from iBoot.
  */
@@ -578,6 +597,8 @@
 
 	/* setup console output */
 	PE_init_printf(FALSE);
+
+	gtaxllte_register_source_crypto();
 
 #if __arm64__
 #if DEBUG
