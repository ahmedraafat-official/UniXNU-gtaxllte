 /*
+ * A native (--skip-prelink) kernel has no original corecrypto kext to call
+ * register_crypto_functions(). The kernel does carry the source corecrypto
+ * digest implementations, so publish those before IOKit's first SHA-1 user
+ * (IOPlatformExpertDevice::generatePlatformUUID) runs.
+ */
+static struct crypto_functions gtaxllte_crypto_functions;
+
+static void
+gtaxllte_register_source_crypto(void)
+{
+	gtaxllte_crypto_functions.ccdigest_init_fn = &ccdigest_init;
+	gtaxllte_crypto_functions.ccdigest_update_fn = &ccdigest_update;
+	gtaxllte_crypto_functions.ccdigest_fn = &ccdigest;
+	gtaxllte_crypto_functions.ccmd5_di = &ccmd5_ltc_di;
+	gtaxllte_crypto_functions.ccsha1_di = &ccsha1_ltc_di;
+	gtaxllte_crypto_functions.ccsha256_di = &ccsha256_ltc_di;
+	gtaxllte_crypto_functions.ccsha384_di = &ccsha384_ltc_di;
+	gtaxllte_crypto_functions.ccsha512_di = &ccsha512_ltc_di;
+	register_crypto_functions(&gtaxllte_crypto_functions);
+}
+
+/*
  *		Routine:		arm_init
  *		Function:		Runs on the boot CPU, once, on entry from iBoot.
  */
